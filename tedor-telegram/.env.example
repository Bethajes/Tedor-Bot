# ---------------------------------------------------------------------------
# Tedor Tutors Telegram Bot — environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Mini App
# ---------------------------------------------------------------------------
# Public HTTPS URL of the deployed Mini App (no trailing slash, no hash).
# The bot appends `#screen=tutor`, `#screen=parent` and `#screen=job&ref=JOB-…`
# to build the WebApp buttons. Leave empty to keep the buttons hidden.
MINI_APP_URL=https://app.example.com/mini

# Signing secret for the web-login JWT used when the Mini App is opened in a
# plain browser. MUST be at least 32 characters and unique to this deployment:
# with it, anyone can mint a token for any Telegram user id.
# When empty, the web login is disabled (Telegram Init Data still works).
MINI_APP_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# How long a one-time login code stays valid, and how many may be requested
# per client address within the rate window.
MINI_APP_CODE_TTL_SECONDS=600
MINI_APP_CODE_RATE_LIMIT=3
MINI_APP_CODE_RATE_WINDOW=3600

# Local development only: returns the one-time code in the API response,
# because there is no bot running to deliver it. NEVER set this in production.
MINI_APP_DEV_CODES=false

# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------
# Channel that receives job posts published with /post
JOB_POST_CHAT_ID=

# Telegram bot token obtained from @BotFather
BOT_TOKEN=

# Telegram user ID(s) allowed to use admin features. Comma separated.
ADMIN_USER_IDS=

# Private chat / channel used for tutor storage archives (add the bot as admin)
TUTOR_STORAGE_CHAT_ID=

# Private chat / channel where student tutor requests are forwarded
STUDENT_REQUEST_CHAT_ID=

# Private chat / channel where support tickets are relayed
SUPPORT_CHAT_ID=

# ---------------------------------------------------------------------------
# Curated location channel
# ---------------------------------------------------------------------------
# The channel the administrator maintains the tutoring-location directory in.
# Channel ids are negative and look like -1001234567890. Get one from
# @userinfobot, or forward a channel post and read the id in the URL.
#
# Leave this EMPTY to disable the feature: the bot then works from the curated
# registry seeded at startup, exactly as before. When it is set:
#
#   * the bot must be an ADMINISTRATOR of the channel, with "Post Messages"
#     not required — it only needs to *receive* channel_post updates;
#   * every post and edit made after that is imported automatically;
#   * posts that already exist must be backfilled once from a channel export:
#         python -m app.import_locations --file result.json
#
# The Bot API has no getChatHistory method, so a bot cannot read posts made
# before it joined. That is why the backfill is a separate, file-based step.
LOCATION_CHANNEL_ID=

# Honour "Status: verified" in a channel post. The channel is written only by
# administrators, so a post is an act of curation. Set to false to force every
# imported record through the in-bot review queue instead.
LOCATION_CHANNEL_TRUST_VERIFIED=true

# Reject a record whose coordinates fall outside Ethiopia. Left on because the
# channel is documented as Addis Ababa, and an out-of-country coordinate is
# always a typo (usually swapped latitude and longitude).
LOCATION_CHANNEL_ENFORCE_BOUNDS=true

# When importing an export, do not overwrite a record that a live channel edit
# already refreshed. Keeps an old export file from rolling back a correction.
LOCATION_CHANNEL_IMPORT_SKIP_STALE=true

# Tell administrators when a channel post is rejected. Off by default: the
# channel is public, and a stranger posting an unrelated message must not be
# able to make the bot message an admin.
LOCATION_CHANNEL_NOTIFY_REJECTIONS=false

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# Shared secret required in the `X-API-Secret` header for protected API routes
API_SECRET=

# REST API bind settings
API_HOST=0.0.0.0
API_PORT=8000

# Comma separated list of allowed CORS origins for the website and Mini App.
# The Mini App's own origin must be listed here when it is served separately.
API_CORS_ORIGINS=https://tedortutors.com,https://app.example.com

# SQLAlchemy connection string (swap for PostgreSQL when migrating)
DATABASE_URL=sqlite:///data/tutor_index.db

# ---------------------------------------------------------------------------
# Site and pricing
# ---------------------------------------------------------------------------
# Public website link used by the "Visit Website" button
WEBSITE_URL=https://tedortutors.com

# Reference exchange rate used to preview the secondary currency rate
ETB_PER_USD=130.0

# ---------------------------------------------------------------------------
# Storage and logging
# ---------------------------------------------------------------------------
# Storage retry behaviour (attempts include the first try)
STORAGE_MAX_ATTEMPTS=3
STORAGE_BACKOFF_SECONDS=1.0

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO